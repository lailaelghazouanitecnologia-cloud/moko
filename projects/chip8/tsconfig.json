{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@chip8/CPU": [
        "src/CPU/index.ts"
      ],
      "@chip8/CPU/*": [
        "src/CPU/*"
      ],
      "@chip8/Display": [
        "src/Display/index.ts"
      ],
      "@chip8/Display/*": [
        "src/Display/*"
      ],
      "@chip8/Emulator": [
        "src/Emulator/index.ts"
      ],
      "@chip8/Emulator/*": [
        "src/Emulator/*"
      ],
      "@chip8/Input": [
        "src/Input/index.ts"
      ],
      "@chip8/Input/*": [
        "src/Input/*"
      ],
      "@chip8/Memory": [
        "src/Memory/index.ts"
      ],
      "@chip8/Memory/*": [
        "src/Memory/*"
      ],
      "@chip8/Timer": [
        "src/Timer/index.ts"
      ],
      "@chip8/Timer/*": [
        "src/Timer/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
