{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@taskflow/core": [
        "src/core/index.ts"
      ],
      "@taskflow/core/*": [
        "src/core/*"
      ],
      "@taskflow/tag": [
        "src/tag/index.ts"
      ],
      "@taskflow/tag/*": [
        "src/tag/*"
      ],
      "@taskflow/identity": [
        "src/identity/index.ts"
      ],
      "@taskflow/identity/*": [
        "src/identity/*"
      ],
      "@taskflow/project": [
        "src/project/index.ts"
      ],
      "@taskflow/project/*": [
        "src/project/*"
      ],
      "@taskflow/task": [
        "src/task/index.ts"
      ],
      "@taskflow/task/*": [
        "src/task/*"
      ],
      "@taskflow/assignment": [
        "src/assignment/index.ts"
      ],
      "@taskflow/assignment/*": [
        "src/assignment/*"
      ],
      "@taskflow/api": [
        "src/api/index.ts"
      ],
      "@taskflow/api/*": [
        "src/api/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
