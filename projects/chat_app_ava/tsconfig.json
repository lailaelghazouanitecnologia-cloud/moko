{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@chat_app_ava/user": [
        "src/user/index.ts"
      ],
      "@chat_app_ava/user/*": [
        "src/user/*"
      ],
      "@chat_app_ava/room": [
        "src/room/index.ts"
      ],
      "@chat_app_ava/room/*": [
        "src/room/*"
      ],
      "@chat_app_ava/message": [
        "src/message/index.ts"
      ],
      "@chat_app_ava/message/*": [
        "src/message/*"
      ],
      "@chat_app_ava/presence": [
        "src/presence/index.ts"
      ],
      "@chat_app_ava/presence/*": [
        "src/presence/*"
      ],
      "@chat_app_ava/gateway": [
        "src/gateway/index.ts"
      ],
      "@chat_app_ava/gateway/*": [
        "src/gateway/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
