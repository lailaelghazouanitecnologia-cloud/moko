{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@x86vm/CPUCore": [
        "src/CPUCore/index.ts"
      ],
      "@x86vm/CPUCore/*": [
        "src/CPUCore/*"
      ],
      "@x86vm/IOPorts": [
        "src/IOPorts/index.ts"
      ],
      "@x86vm/IOPorts/*": [
        "src/IOPorts/*"
      ],
      "@x86vm/InstructionDecoder": [
        "src/InstructionDecoder/index.ts"
      ],
      "@x86vm/InstructionDecoder/*": [
        "src/InstructionDecoder/*"
      ],
      "@x86vm/MemoryManager": [
        "src/MemoryManager/index.ts"
      ],
      "@x86vm/MemoryManager/*": [
        "src/MemoryManager/*"
      ],
      "@x86vm/Registers": [
        "src/Registers/index.ts"
      ],
      "@x86vm/Registers/*": [
        "src/Registers/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
