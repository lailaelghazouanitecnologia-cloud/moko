{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@x86vm/cpu_core": [
        "src/cpu_core/index.ts"
      ],
      "@x86vm/cpu_core/*": [
        "src/cpu_core/*"
      ],
      "@x86vm/decoder": [
        "src/decoder/index.ts"
      ],
      "@x86vm/decoder/*": [
        "src/decoder/*"
      ],
      "@x86vm/io": [
        "src/io/index.ts"
      ],
      "@x86vm/io/*": [
        "src/io/*"
      ],
      "@x86vm/memory": [
        "src/memory/index.ts"
      ],
      "@x86vm/memory/*": [
        "src/memory/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
