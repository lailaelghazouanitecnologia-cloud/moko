{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@autoresearch/core": [
        "src/core/index.ts"
      ],
      "@autoresearch/core/*": [
        "src/core/*"
      ],
      "@autoresearch/io": [
        "src/io/index.ts"
      ],
      "@autoresearch/io/*": [
        "src/io/*"
      ],
      "@autoresearch/runner": [
        "src/runner/index.ts"
      ],
      "@autoresearch/runner/*": [
        "src/runner/*"
      ],
      "@autoresearch/evaluator": [
        "src/evaluator/index.ts"
      ],
      "@autoresearch/evaluator/*": [
        "src/evaluator/*"
      ],
      "@autoresearch/versioning": [
        "src/versioning/index.ts"
      ],
      "@autoresearch/versioning/*": [
        "src/versioning/*"
      ],
      "@autoresearch/planner": [
        "src/planner/index.ts"
      ],
      "@autoresearch/planner/*": [
        "src/planner/*"
      ],
      "@autoresearch/agent": [
        "src/agent/index.ts"
      ],
      "@autoresearch/agent/*": [
        "src/agent/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
