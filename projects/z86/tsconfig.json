{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@z86/animation": [
        "src/animation/index.ts"
      ],
      "@z86/animation/*": [
        "src/animation/*"
      ],
      "@z86/app": [
        "src/app/index.ts"
      ],
      "@z86/app/*": [
        "src/app/*"
      ],
      "@z86/audio": [
        "src/audio/index.ts"
      ],
      "@z86/audio/*": [
        "src/audio/*"
      ],
      "@z86/core": [
        "src/core/index.ts"
      ],
      "@z86/core/*": [
        "src/core/*"
      ],
      "@z86/graphics": [
        "src/graphics/index.ts"
      ],
      "@z86/graphics/*": [
        "src/graphics/*"
      ],
      "@z86/input": [
        "src/input/index.ts"
      ],
      "@z86/input/*": [
        "src/input/*"
      ],
      "@z86/math": [
        "src/math/index.ts"
      ],
      "@z86/math/*": [
        "src/math/*"
      ],
      "@z86/physics": [
        "src/physics/index.ts"
      ],
      "@z86/physics/*": [
        "src/physics/*"
      ],
      "@z86/scene": [
        "src/scene/index.ts"
      ],
      "@z86/scene/*": [
        "src/scene/*"
      ],
      "@z86/ui": [
        "src/ui/index.ts"
      ],
      "@z86/ui/*": [
        "src/ui/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
