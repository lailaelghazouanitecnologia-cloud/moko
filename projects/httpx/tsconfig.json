{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@httpx/middleware": [
        "src/middleware/index.ts"
      ],
      "@httpx/middleware/*": [
        "src/middleware/*"
      ],
      "@httpx/request": [
        "src/request/index.ts"
      ],
      "@httpx/request/*": [
        "src/request/*"
      ],
      "@httpx/response": [
        "src/response/index.ts"
      ],
      "@httpx/response/*": [
        "src/response/*"
      ],
      "@httpx/router": [
        "src/router/index.ts"
      ],
      "@httpx/router/*": [
        "src/router/*"
      ],
      "@httpx/server": [
        "src/server/index.ts"
      ],
      "@httpx/server/*": [
        "src/server/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
