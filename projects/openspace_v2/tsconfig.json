{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@openspace_v2/agents": [
        "src/agents/index.ts"
      ],
      "@openspace_v2/agents/*": [
        "src/agents/*"
      ],
      "@openspace_v2/grounding": [
        "src/grounding/index.ts"
      ],
      "@openspace_v2/grounding/*": [
        "src/grounding/*"
      ],
      "@openspace_v2/prompts": [
        "src/prompts/index.ts"
      ],
      "@openspace_v2/prompts/*": [
        "src/prompts/*"
      ],
      "@openspace_v2/utils": [
        "src/utils/index.ts"
      ],
      "@openspace_v2/utils/*": [
        "src/utils/*"
      ],
      "@openspace_v2/skill_engine": [
        "src/skill_engine/index.ts"
      ],
      "@openspace_v2/skill_engine/*": [
        "src/skill_engine/*"
      ],
      "@openspace_v2/recording": [
        "src/recording/index.ts"
      ],
      "@openspace_v2/recording/*": [
        "src/recording/*"
      ],
      "@openspace_v2/llm": [
        "src/llm/index.ts"
      ],
      "@openspace_v2/llm/*": [
        "src/llm/*"
      ],
      "@openspace_v2/platform": [
        "src/platform/index.ts"
      ],
      "@openspace_v2/platform/*": [
        "src/platform/*"
      ],
      "@openspace_v2/host_detection": [
        "src/host_detection/index.ts"
      ],
      "@openspace_v2/host_detection/*": [
        "src/host_detection/*"
      ],
      "@openspace_v2/config": [
        "src/config/index.ts"
      ],
      "@openspace_v2/config/*": [
        "src/config/*"
      ],
      "@openspace_v2/cloud": [
        "src/cloud/index.ts"
      ],
      "@openspace_v2/cloud/*": [
        "src/cloud/*"
      ],
      "@openspace_v2/local_server": [
        "src/local_server/index.ts"
      ],
      "@openspace_v2/local_server/*": [
        "src/local_server/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
