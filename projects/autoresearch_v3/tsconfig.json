{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@autoresearch_v3/config": [
        "src/config/index.ts"
      ],
      "@autoresearch_v3/config/*": [
        "src/config/*"
      ],
      "@autoresearch_v3/evaluator": [
        "src/evaluator/index.ts"
      ],
      "@autoresearch_v3/evaluator/*": [
        "src/evaluator/*"
      ],
      "@autoresearch_v3/script_mutator": [
        "src/script_mutator/index.ts"
      ],
      "@autoresearch_v3/script_mutator/*": [
        "src/script_mutator/*"
      ],
      "@autoresearch_v3/loop": [
        "src/loop/index.ts"
      ],
      "@autoresearch_v3/loop/*": [
        "src/loop/*"
      ],
      "@autoresearch_v3/experiment_runner": [
        "src/experiment_runner/index.ts"
      ],
      "@autoresearch_v3/experiment_runner/*": [
        "src/experiment_runner/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
