{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@openspace_ava/core": [
        "src/core/index.ts"
      ],
      "@openspace_ava/core/*": [
        "src/core/*"
      ],
      "@openspace_ava/models": [
        "src/models/index.ts"
      ],
      "@openspace_ava/models/*": [
        "src/models/*"
      ],
      "@openspace_ava/services": [
        "src/services/index.ts"
      ],
      "@openspace_ava/services/*": [
        "src/services/*"
      ],
      "@openspace_ava/routes": [
        "src/routes/index.ts"
      ],
      "@openspace_ava/routes/*": [
        "src/routes/*"
      ],
      "@openspace_ava/server": [
        "src/server/index.ts"
      ],
      "@openspace_ava/server/*": [
        "src/server/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
