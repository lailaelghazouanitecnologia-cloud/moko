{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@snake_ava/domain": [
        "src/domain/index.ts"
      ],
      "@snake_ava/domain/*": [
        "src/domain/*"
      ],
      "@snake_ava/score": [
        "src/score/index.ts"
      ],
      "@snake_ava/score/*": [
        "src/score/*"
      ],
      "@snake_ava/renderer": [
        "src/renderer/index.ts"
      ],
      "@snake_ava/renderer/*": [
        "src/renderer/*"
      ],
      "@snake_ava/input": [
        "src/input/index.ts"
      ],
      "@snake_ava/input/*": [
        "src/input/*"
      ],
      "@snake_ava/collision": [
        "src/collision/index.ts"
      ],
      "@snake_ava/collision/*": [
        "src/collision/*"
      ],
      "@snake_ava/game_loop": [
        "src/game_loop/index.ts"
      ],
      "@snake_ava/game_loop/*": [
        "src/game_loop/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
