{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@zzo/core": [
        "src/core/index.ts"
      ],
      "@zzo/core/*": [
        "src/core/*"
      ],
      "@zzo/diff": [
        "src/diff/index.ts"
      ],
      "@zzo/diff/*": [
        "src/diff/*"
      ],
      "@zzo/storage": [
        "src/storage/index.ts"
      ],
      "@zzo/storage/*": [
        "src/storage/*"
      ],
      "@zzo/index": [
        "src/index/index.ts"
      ],
      "@zzo/index/*": [
        "src/index/*"
      ],
      "@zzo/transport": [
        "src/transport/index.ts"
      ],
      "@zzo/transport/*": [
        "src/transport/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
