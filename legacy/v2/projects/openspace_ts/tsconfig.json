{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@openspace_ts/config": [
        "src/config/index.ts"
      ],
      "@openspace_ts/config/*": [
        "src/config/*"
      ],
      "@openspace_ts/grounding": [
        "src/grounding/index.ts"
      ],
      "@openspace_ts/grounding/*": [
        "src/grounding/*"
      ],
      "@openspace_ts/llm": [
        "src/llm/index.ts"
      ],
      "@openspace_ts/llm/*": [
        "src/llm/*"
      ],
      "@openspace_ts/core": [
        "src/core/index.ts"
      ],
      "@openspace_ts/core/*": [
        "src/core/*"
      ],
      "@openspace_ts/agents": [
        "src/agents/index.ts"
      ],
      "@openspace_ts/agents/*": [
        "src/agents/*"
      ],
      "@openspace_ts/recording": [
        "src/recording/index.ts"
      ],
      "@openspace_ts/recording/*": [
        "src/recording/*"
      ],
      "@openspace_ts/cloud": [
        "src/cloud/index.ts"
      ],
      "@openspace_ts/cloud/*": [
        "src/cloud/*"
      ],
      "@openspace_ts/ui": [
        "src/ui/index.ts"
      ],
      "@openspace_ts/ui/*": [
        "src/ui/*"
      ],
      "@openspace_ts/prompts": [
        "src/prompts/index.ts"
      ],
      "@openspace_ts/prompts/*": [
        "src/prompts/*"
      ],
      "@openspace_ts/platform": [
        "src/platform/index.ts"
      ],
      "@openspace_ts/platform/*": [
        "src/platform/*"
      ],
      "@openspace_ts/evolution": [
        "src/evolution/index.ts"
      ],
      "@openspace_ts/evolution/*": [
        "src/evolution/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
