digraph "mastra" {
  rankdir=LR;
  label="mastra (L0: 20n, 1e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "__root__" [label="__root__ (0t, 1f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "auth" [label="auth (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "client-sdks" [label="client-sdks (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "deployers" [label="deployers (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "docs" [label="docs (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "e2e-tests" [label="e2e-tests (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "examples" [label="examples (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "explorations" [label="explorations (9t, 17f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "integrations" [label="integrations (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "mastracode" [label="mastracode (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "observability" [label="observability (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "packages" [label="packages (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "pubsub" [label="pubsub (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "scripts" [label="scripts (5t, 12f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "server-adapters" [label="server-adapters (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "stores" [label="stores (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "templates" [label="templates (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "voice" [label="voice (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "workflows" [label="workflows (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "workspaces" [label="workspaces (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

  "explorations" -> "docs" [label="calls", style=solid, color="#50C878"];
}
