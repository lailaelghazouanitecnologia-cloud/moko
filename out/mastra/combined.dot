digraph "mastra" {
  rankdir=LR;
  label="mastra — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster___root__" {
    label="__root__";
    style=rounded;
    color="#4A90D9";

    "__root__.discoverProjects" [label="discoverProjects", shape=ellipse, style=filled, fillcolor="#50C878"];
    "__root__.discoverProjects" -> "/test:\\s*\\{[\\s\\S]*?projects:\\s*\\[/.test" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "EXCLUDED_DIRS.has" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "PROJECT_GLOBS.flatMap" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "console.warn" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "dirname" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "loadConfigFromFile" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "process.cwd" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "projects.push" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "readFileSync" [label="calls", style=solid, color="#50C878"];
    "__root__.discoverProjects" -> "resolve" [label="calls", style=solid, color="#50C878"];
  }

  subgraph "cluster_auth" {
    label="auth";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_client-sdks" {
    label="client-sdks";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_deployers" {
    label="deployers";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_docs" {
    label="docs";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_e2e-tests" {
    label="e2e-tests";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_examples" {
    label="examples";
    style=rounded;
    color="#4A90D9";

