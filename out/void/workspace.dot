digraph "void" {
  rankdir=LR;
  label="void (L0: 6n, 1e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  ".eslint-plugin-local" [label=".eslint-plugin-local (6t, 7f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  ".vscode" [label=".vscode (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "extensions" [label="extensions (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "scripts" [label="scripts (14t, 9f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "src" [label="src (1t, 35f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "test" [label="test (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

  "src" -> "scripts" [label="calls", style=solid, color="#50C878"];
}
