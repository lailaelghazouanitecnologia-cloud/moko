digraph ".eslint-plugin-local" {
  rankdir=LR;
  label=".eslint-plugin-local (L1: 13n, 5e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  ".eslint-plugin-local.createImportRuleListener" [label=".eslint-plugin-local.createImportRuleListener", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.isStringLiteral" [label=".eslint-plugin-local.isStringLiteral", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.isDoubleQuoted" [label=".eslint-plugin-local.isDoubleQuoted", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.Config" [label=".eslint-plugin-local.Config", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.isCallExpression" [label=".eslint-plugin-local.isCallExpression", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.isFunctionExpression" [label=".eslint-plugin-local.isFunctionExpression", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.ConditionalPattern" [label=".eslint-plugin-local.ConditionalPattern", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.RawImportPatternsConfig" [label=".eslint-plugin-local.RawImportPatternsConfig", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.LayerAllowRule" [label=".eslint-plugin-local.LayerAllowRule", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.RawOption" [label=".eslint-plugin-local.RawOption", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.ImportPatternsConfig" [label=".eslint-plugin-local.ImportPatternsConfig", shape=record, style=filled, fillcolor="#E8A838"];
  ".eslint-plugin-local.isLayerAllowRule" [label=".eslint-plugin-local.isLayerAllowRule", shape=ellipse, style=filled, fillcolor="#50C878"];
  ".eslint-plugin-local.getRelativeFilename" [label=".eslint-plugin-local.getRelativeFilename", shape=ellipse, style=filled, fillcolor="#50C878"];

  ".eslint-plugin-local.isFunctionExpression" -> "node.type.includes" [label="calls", style=solid, color="#50C878"];
  ".eslint-plugin-local.getRelativeFilename" -> "context.getFilename" [label="calls", style=solid, color="#50C878"];
  ".eslint-plugin-local.getRelativeFilename" -> "filename.substring" [label="calls", style=solid, color="#50C878"];
  ".eslint-plugin-local.getRelativeFilename" -> "filename.substring(REPO_ROOT.length).replace" [label="calls", style=solid, color="#50C878"];
  ".eslint-plugin-local.getRelativeFilename" -> "path.normalize" [label="calls", style=solid, color="#50C878"];
}
