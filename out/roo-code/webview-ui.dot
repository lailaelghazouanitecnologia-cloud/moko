digraph "webview-ui" {
  rankdir=LR;
  label="webview-ui (L1: 4n, 6e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "webview-ui.MockResizeObserver" [label="webview-ui.MockResizeObserver", shape=record, style=filled, fillcolor="#E8A838"];
  "webview-ui.getGitSha" [label="webview-ui.getGitSha", shape=ellipse, style=filled, fillcolor="#50C878"];
  "webview-ui.wasmPlugin" [label="webview-ui.wasmPlugin", shape=ellipse, style=filled, fillcolor="#50C878"];
  "webview-ui.persistPortPlugin" [label="webview-ui.persistPortPlugin", shape=ellipse, style=filled, fillcolor="#50C878"];

  "webview-ui.getGitSha" -> "execSync" [label="calls", style=solid, color="#50C878"];
  "webview-ui.getGitSha" -> "execSync(\"git rev-parse HEAD\").toString" [label="calls", style=solid, color="#50C878"];
  "webview-ui.getGitSha" -> "execSync(\"git rev-parse HEAD\").toString().trim" [label="calls", style=solid, color="#50C878"];
  "webview-ui.wasmPlugin" -> "id.endsWith" [label="calls", style=solid, color="#50C878"];
  "webview-ui.wasmPlugin" -> "import" [label="calls", style=solid, color="#50C878"];
  "webview-ui.persistPortPlugin" -> "viteDevServer?.httpServer?.once" [label="calls", style=solid, color="#50C878"];
}
