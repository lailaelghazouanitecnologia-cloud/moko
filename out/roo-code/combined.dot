digraph "roo-code" {
  rankdir=LR;
  label="roo-code — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_apps" {
    label="apps";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_packages" {
    label="packages";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_src" {
    label="src";
    style=rounded;
    color="#4A90D9";

    "src.allowNetConnect" [label="allowNetConnect", shape=ellipse, style=filled, fillcolor="#50C878"];
    "src.checkWorktreeAutoOpen" [label="checkWorktreeAutoOpen", shape=ellipse, style=filled, fillcolor="#50C878"];
    "src.activate" [label="activate", shape=ellipse, style=filled, fillcolor="#50C878"];
    "src.deactivate" [label="deactivate", shape=ellipse, style=filled, fillcolor="#50C878"];
    "src.allowNetConnect" -> "nock.enableNetConnect" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "String" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "context.globalState.get" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "context.globalState.update" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "normalizePath" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "outputChannel.appendLine" [label="calls", style=solid, color="#50C878"];
    "src.checkWorktreeAutoOpen" -> "setTimeout" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "Buffer.from" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "Buffer.from(uri.query, \"base64\").toString" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "CloudService.createInstance" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "CodeIndexManager.getInstance" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "ContextProxy.getInstance" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "JSON.stringify" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "MdmService.createInstance" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "String" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "TelemetryService.createInstance" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "TelemetryService.instance.register" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "TelemetryService.instance.setProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "TerminalRegistry.initialize" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "autoImportSettings" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "checkWorktreeAutoOpen" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "codeIndexManagers.push" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "console.log" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "console.warn" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "context.globalState.get" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "context.globalState.update" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "context.subscriptions.push" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "createDualLogger" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "createOutputChannelLogger" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "customToolRegistry.setExtensionPath" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "formatLanguage" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "initializeI18n" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "initializeModelCacheRefresh" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "initializeNetworkProxy" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "manager.initialize" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "manager.initialize(contextProxy).catch" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "migrateSettings" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "new (class implements vscode.TextDocumentContentProvider {\n		provideTextDocumentContent(uri: vscode.Uri): string {\n			return Buffer.from(uri.query, \"base64\").toString(\"utf-8\")\n		}\n	})" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "new API" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "new ClineProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "new CodeActionProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "new PostHogTelemetryClient" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "openAiCodexOAuthManager.initialize" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "outputChannel.appendLine" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "path.join" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "provider.initializeCloudProfileSyncWhenReady" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "registerCodeActions" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "registerCommands" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "registerTerminalActions" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "telemetryService.register" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.commands.executeCommand" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.languages.registerCodeActionsProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.window.createOutputChannel" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.window.registerUriHandler" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.window.registerWebviewViewProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.workspace.getConfiguration" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.workspace.getConfiguration(Package.name).get" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "vscode.workspace.registerTextDocumentContentProvider" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "watchPaths.forEach" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "watchPaths.map" [label="calls", style=solid, color="#50C878"];
    "src.activate" -> "watchPaths.map(({ path }) => path).join" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "CloudService.hasInstance" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "CloudService.instance.off" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "McpServerManager.cleanup" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "String" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "TelemetryService.instance.shutdown" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "TerminalRegistry.cleanup" [label="calls", style=solid, color="#50C878"];
    "src.deactivate" -> "outputChannel.appendLine" [label="calls", style=solid, color="#50C878"];
  }

  subgraph "cluster_webview-ui" {
    label="webview-ui";
    style=rounded;
    color="#4A90D9";

    "webview-ui.MockResizeObserver" [label="MockResizeObserver", shape=record, style=filled, fillcolor="#E8A838"];
    "webview-ui.getGitSha" [label="getGitSha", shape=ellipse, style=filled, fillcolor="#50C878"];
    "webview-ui.wasmPlugin" [label="wasmPlugin", shape=ellipse, style=filled, fillcolor="#50C878"];
    "webview-ui.persistPortPlugin" [label="persistPortPlugin", shape=ellipse, style=filled, fillcolor="#50C878"];
    "webview-ui.getGitSha" -> "execSync" [label="calls", style=solid, color="#50C878"];
    "webview-ui.getGitSha" -> "execSync(\"git rev-parse HEAD\").toString" [label="calls", style=solid, color="#50C878"];
    "webview-ui.getGitSha" -> "execSync(\"git rev-parse HEAD\").toString().trim" [label="calls", style=solid, color="#50C878"];
    "webview-ui.wasmPlugin" -> "id.endsWith" [label="calls", style=solid, color="#50C878"];
    "webview-ui.wasmPlugin" -> "import" [label="calls", style=solid, color="#50C878"];
    "webview-ui.persistPortPlugin" -> "viteDevServer?.httpServer?.once" [label="calls", style=solid, color="#50C878"];
  }

}
