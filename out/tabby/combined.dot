digraph "tabby" {
  rankdir=LR;
  label="tabby — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_clients" {
    label="clients";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_ee" {
    label="ee";
    style=rounded;
    color="#4A90D9";

  }

}
