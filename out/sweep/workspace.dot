digraph "sweep" {
  rankdir=LR;
  label="sweep (L0: 3n, 2e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "docs" [label="docs (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "sweepai" [label="sweepai (2t, 34f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "tests" [label="tests (4t, 28f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

  "sweepai" -> "tests" [label="calls", style=solid, color="#50C878"];
  "tests" -> "sweepai" [label="imports", style=solid, color="#4A90D9"];
}
