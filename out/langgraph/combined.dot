digraph "langgraph" {
  rankdir=LR;
  label="langgraph — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_.github" {
    label=".github";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_docs" {
    label="docs";
    style=rounded;
    color="#4A90D9";

    "docs.generate_redirects" [label="generate_redirects", shape=ellipse, style=filled, fillcolor="#50C878"];
    "docs.generate_redirects" -> "CATCHALL_404_TEMPLATE.format" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "HTML_TEMPLATE.format" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "Path" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "ROOT_HTML_TEMPLATE.format" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "catchall_404.write_text" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "dst.write_text" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "html_path.parent.mkdir" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "html_path.write_text" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "json.load" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "len" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "old_path.lstrip" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "open" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "output_dir.exists" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "output_dir.mkdir" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "print" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "redirects.items" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "root_index.exists" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "root_index.write_text" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "shutil.rmtree" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "src.exists" [label="calls", style=solid, color="#50C878"];
    "docs.generate_redirects" -> "src.read_text" [label="calls", style=solid, color="#50C878"];
  }

  subgraph "cluster_examples" {
    label="examples";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_libs" {
    label="libs";
    style=rounded;
    color="#4A90D9";

  }

}
