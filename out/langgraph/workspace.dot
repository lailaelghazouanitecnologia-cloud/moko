digraph "langgraph" {
  rankdir=LR;
  label="langgraph (L0: 4n, 0e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  ".github" [label=".github (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "docs" [label="docs (0t, 1f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "examples" [label="examples (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "libs" [label="libs (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

}
