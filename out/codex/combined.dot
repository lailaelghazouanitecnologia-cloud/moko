digraph "openai-codex" {
  rankdir=LR;
  label="openai-codex — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_codex-rs" {
    label="codex-rs";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_sdk" {
    label="sdk";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_shell-tool-mcp" {
    label="shell-tool-mcp";
    style=rounded;
    color="#4A90D9";

  }

}
