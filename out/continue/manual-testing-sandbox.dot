digraph "manual-testing-sandbox" {
  rankdir=LR;
  label="manual-testing-sandbox (L1: 2n, 1e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "manual-testing-sandbox.Calculator" [label="manual-testing-sandbox.Calculator", shape=record, style=filled, fillcolor="#E8A838"];
  "manual-testing-sandbox.toggleDarkMode" [label="manual-testing-sandbox.toggleDarkMode", shape=ellipse, style=filled, fillcolor="#50C878"];

  "manual-testing-sandbox.Calculator.divide" -> "new Error" [label="calls", style=solid, color="#50C878"];
}
