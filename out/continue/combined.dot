digraph "continue" {
  rankdir=LR;
  label="continue — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_binary" {
    label="binary";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_core" {
    label="core";
    style=rounded;
    color="#4A90D9";

    "core.Core" [label="Core", shape=record, style=filled, fillcolor="#E8A838"];
    "core.Core.invoke" -> "this.messenger.invoke" [label="calls", style=solid, color="#50C878"];
    "core.Core.send" -> "this.messenger.send" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "CodebaseRulesCache.getInstance" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "DataLogger.getInstance" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "DocsService.createSingleton" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "Logger.error" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "MCPManagerSingleton.getInstance" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "NextEditProvider.initialize" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "codebaseRulesCache\n        .refresh" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "codebaseRulesCache\n        .refresh(ide)\n        .catch" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "codebaseRulesCache\n        .refresh(ide)\n        .catch((e) =>\n          Logger.error(\"Failed to ini..." [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "ideSettingsPromise.then" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "messenger.request" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "migrateV1DevDataFiles" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "new CodebaseIndexer" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "new CompletionProvider" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "new ConfigHandler" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "this.configHandler.onConfigUpdate" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "this.globalContext.get" [label="calls", style=solid, color="#50C878"];
    "core.Core.constructor" -> "this.registerMessageHandlers" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "on" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.getContextItems.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.handleAddAutocompleteModel.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.handleCompleteOnboarding.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.handleFilesChanged.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.handleListModels.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.messenger.on.bind" [label="calls", style=solid, color="#50C878"];
    "core.Core.registerMessageHandlers" -> "this.messenger.onError" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleToolCall" -> "callTool" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleToolCall" -> "config.tools.find" [label="calls", style=solid, color="#50C878"];
