    "core.Core.handleFilesChanged" -> "codebaseRulesCache.update(this.ide, uri).then" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "diffCache.invalidate" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "getDiffFn" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "isColocatedRulesFile" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "isContinueConfigRelatedUri" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "shouldIgnore" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.codeBaseIndexer.refreshCodebaseIndexFiles" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.configHandler.loadConfig" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.configHandler.reloadConfig" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.globalContext.get" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.globalContext.update" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.ide.showToast" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "this.invoke" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "uri.endsWith" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "walkDirCache.invalidate" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "config.modelsByRole.chat.find" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "console.debug" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "model.listModels" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "new Lemonade" [label="calls", style=solid, color="#50C878"];
