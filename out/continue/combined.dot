    "core.Core.isItemTooBig" -> "new Error" [label="calls", style=solid, color="#50C878"];
    "core.Core.isItemTooBig" -> "this.configHandler.loadConfig" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleAddAutocompleteModel" -> "editConfigFile" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleAddAutocompleteModel" -> "this.configHandler.reloadConfig" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "CodebaseRulesCache.getInstance" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "GitDiffCache.getInstance" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "Logger.error" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleFilesChanged" -> "URI.equal" [label="calls", style=solid, color="#50C878"];
