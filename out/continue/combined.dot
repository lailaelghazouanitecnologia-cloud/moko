    "core.Core.handleListModels" -> "new Ollama" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "new Ollama({ model: \"\" }).listModels" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleListModels" -> "this.configHandler.loadConfig" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleCompleteOnboarding" -> "Logger.error" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleCompleteOnboarding" -> "editConfigFile" [label="calls", style=solid, color="#50C878"];
    "core.Core.handleCompleteOnboarding" -> "this.configHandler.reloadConfig" [label="calls", style=solid, color="#50C878"];
  }

  subgraph "cluster_extensions" {
    label="extensions";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_gui" {
    label="gui";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_manual-testing-sandbox" {
    label="manual-testing-sandbox";
    style=rounded;
    color="#4A90D9";

    "manual-testing-sandbox.Calculator" [label="Calculator", shape=record, style=filled, fillcolor="#E8A838"];
    "manual-testing-sandbox.toggleDarkMode" [label="toggleDarkMode", shape=ellipse, style=filled, fillcolor="#50C878"];
    "manual-testing-sandbox.Calculator.divide" -> "new Error" [label="calls", style=solid, color="#50C878"];
  }

  subgraph "cluster_packages" {
    label="packages";
    style=rounded;
    color="#4A90D9";

  }

}
