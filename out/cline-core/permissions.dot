digraph "permissions" {
  rankdir=LR;
  label="permissions (L1: 5n, 19e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "permissions.ParsedCommand" [label="permissions.ParsedCommand", shape=record, style=filled, fillcolor="#E8A838"];
  "permissions.CommandPermissionController" [label="permissions.CommandPermissionController", shape=record, style=filled, fillcolor="#E8A838"];
  "permissions.CommandPermissionConfig" [label="permissions.CommandPermissionConfig", shape=record, style=filled, fillcolor="#E8A838"];
  "permissions.PermissionValidationResult" [label="permissions.PermissionValidationResult", shape=record, style=filled, fillcolor="#E8A838"];
  "permissions.ShellOperatorMatch" [label="permissions.ShellOperatorMatch", shape=record, style=filled, fillcolor="#E8A838"];

  "permissions.CommandPermissionController.constructor" -> "this.parseConfig" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseConfig" -> "Array.isArray" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseConfig" -> "JSON.parse" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseConfig" -> "Logger.error" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateCommand" -> "this.detectDangerousCharsOutsideQuotes" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateCommand" -> "this.parseCommandSegments" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateCommand" -> "this.validateParsedCommand" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateParsedCommand" -> "this.validateParsedCommand" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateParsedCommand" -> "this.validateSingleCommand" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.validateSingleCommand" -> "this.matchesPattern" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseCommandSegments" -> "Logger.error" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseCommandSegments" -> "parse" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.parseCommandSegments" -> "process" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.matchesPattern" -> "new RegExp" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.matchesPattern" -> "pattern\n					.replace" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.matchesPattern" -> "pattern\n					.replace(/[.+^${}()|[\\]\\\\]/g, \"\\\\$&\") // escape special regex chars\n					.replace" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.matchesPattern" -> "pattern\n					.replace(/[.+^${}()|[\\]\\\\]/g, \"\\\\$&\") // escape special regex chars\n					.replace(/\\*/g..." [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.matchesPattern" -> "regex.test" [label="calls", style=solid, color="#50C878"];
  "permissions.CommandPermissionController.detectDangerousCharsOutsideQuotes" -> "LINE_SEPARATOR_REGEX.test" [label="calls", style=solid, color="#50C878"];
}
