digraph "prompts" {
  rankdir=LR;
  label="prompts (L1: 10n, 9e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "prompts.newTaskToolResponse" [label="prompts.newTaskToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.condenseToolResponse" [label="prompts.condenseToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.newRuleToolResponse" [label="prompts.newRuleToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.reportBugToolResponse" [label="prompts.reportBugToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.explainChangesToolResponse" [label="prompts.explainChangesToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.deepPlanningToolResponse" [label="prompts.deepPlanningToolResponse", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.formatImagesIntoBlocks" [label="prompts.formatImagesIntoBlocks", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.summarizeTask" [label="prompts.summarizeTask", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.continuationPrompt" [label="prompts.continuationPrompt", shape=ellipse, style=filled, fillcolor="#50C878"];
  "prompts.loadMcpDocumentation" [label="prompts.loadMcpDocumentation", shape=ellipse, style=filled, fillcolor="#50C878"];

  "prompts.deepPlanningToolResponse" -> "getDeepPlanningPrompt" [label="calls", style=solid, color="#50C878"];
  "prompts.formatImagesIntoBlocks" -> "images.map" [label="calls", style=solid, color="#50C878"];
  "prompts.summarizeTask" -> "cwd.toPosix" [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub\n			.getServers" [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub\n			.getServers()\n			.filter" [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub\n			.getServers()\n			.filter((server) => server.status === \"connected\")\n			.map" [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub\n			.getServers()\n			.filter((server) => server.status === \"connected\")\n			.map((server) => se..." [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub.getMcpServersPath" [label="calls", style=solid, color="#50C878"];
  "prompts.loadMcpDocumentation" -> "mcpHub.getMcpSettingsFilePath" [label="calls", style=solid, color="#50C878"];
}
