digraph "agno" {
  rankdir=LR;
  label="agno — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_cookbook" {
    label="cookbook";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_libs" {
    label="libs";
    style=rounded;
    color="#4A90D9";

  }

}
