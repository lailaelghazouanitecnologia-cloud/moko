digraph "goose" {
  rankdir=LR;
  label="goose — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_documentation" {
    label="documentation";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_evals" {
    label="evals";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_services" {
    label="services";
    style=rounded;
    color="#4A90D9";

  }

  subgraph "cluster_ui" {
    label="ui";
    style=rounded;
    color="#4A90D9";

  }

}
