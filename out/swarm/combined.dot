digraph "swarm" {
  rankdir=LR;
  label="swarm — Combined Graph";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7];
  compound=true;

  subgraph "cluster_examples" {
    label="examples";
    style=rounded;
    color="#4A90D9";

  }

