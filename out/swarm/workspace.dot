digraph "swarm" {
  rankdir=LR;
  label="swarm (L0: 3n, 2e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "examples" [label="examples (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "swarm" [label="swarm (4t, 4f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "tests" [label="tests (1t, 8f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

  "tests" -> "swarm" [label="imports", style=solid, color="#4A90D9"];
  "tests" -> "swarm" [label="calls", style=solid, color="#50C878"];
}
