digraph "glm4" {
  rankdir=LR;
  label="glm4 (L0: 3n, 1e, 0p)";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];

  "demo" [label="demo (0t, 0f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "finetune" [label="finetune (6t, 15f)", shape=box3d, style=filled, fillcolor="#4A90D9"];
  "inference" [label="inference (16t, 24f)", shape=box3d, style=filled, fillcolor="#4A90D9"];

  "finetune" -> "inference" [label="calls", style=solid, color="#50C878"];
}
